# Postgres connection string. On Vercel the Neon integration sets this for you;
# locally run `vercel env pull .env` (or paste a Neon branch URL / any local Postgres URL).
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Long random string; signs login cookies
PAYLOAD_SECRET=change-me
# Vercel Blob read/write token; when set, uploaded media is stored in Blob instead of the local disk
BLOB_READ_WRITE_TOKEN=
